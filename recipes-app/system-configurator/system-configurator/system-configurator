#!/usr/bin/env python3
"""Configure hostname and static Ethernet IPv4 settings."""

from __future__ import annotations

import argparse
import ipaddress
import socket
import subprocess
import sys
from pathlib import Path
import re


NETWORK_FILE = Path("/etc/systemd/network/10-wired.network")
INTERFACE = "eth0"
INTERFACE_RE = re.compile(r"^[A-Za-z0-9_.:-]+$")


def command(args: list[str]) -> None:
    try:
        subprocess.run(args, check=True)
    except FileNotFoundError as exc:
        raise RuntimeError(f"Required command not found: {args[0]}") from exc
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(f"Command failed ({exc.returncode}): {' '.join(args)}") from exc


def valid_hostname(value: str) -> str:
    value = value.strip()
    if not value or len(value) > 63 or value.startswith("-") or value.endswith("-"):
        raise ValueError("Hostname must be 1-63 characters and cannot start or end with '-'.")
    if any(not (char.isalnum() or char == "-") for char in value):
        raise ValueError("Hostname may contain only letters, digits and hyphens.")
    return value


def current_hostname() -> str:
    """Read the configured hostname from the local hostname file."""
    try:
        configured = Path("/etc/hostname").read_text(encoding="utf-8").strip().splitlines()[0]
        if configured:
            return configured.strip()
    except (OSError, IndexError):
        pass
    return socket.gethostname()


def valid_ipv4(value: str, label: str, required: bool = False) -> str:
    value = value.strip()
    if not value and not required:
        return ""
    try:
        return str(ipaddress.IPv4Address(value))
    except ipaddress.AddressValueError as exc:
        raise ValueError(f"{label} must be a valid IPv4 address.") from exc


def available_interfaces() -> list[str]:
    """Return physical/network interfaces visible on the running Raspberry Pi."""
    try:
        interfaces = sorted(path.name for path in Path("/sys/class/net").iterdir())
    except OSError:
        interfaces = []
    return [interface for interface in interfaces if interface != "lo"]


def configured_interface() -> str:
    try:
        lines = NETWORK_FILE.read_text(encoding="utf-8").splitlines()
    except OSError:
        return INTERFACE
    for line in lines:
        key, separator, value = line.partition("=")
        if separator and key.strip() == "Name" and value.strip():
            return value.strip()
    return INTERFACE


def valid_interface(value: str) -> str:
    value = value.strip()
    if not value or not INTERFACE_RE.fullmatch(value):
        raise ValueError("Interface name contains invalid characters.")
    interfaces = available_interfaces()
    if interfaces and value not in interfaces:
        raise ValueError(f"Interface '{value}' is not available. Choose one of: {', '.join(interfaces)}")
    return value


def current_network(interface: str) -> dict[str, str | bool]:
    result: dict[str, str | bool] = {
        "static": False, "interface": interface, "ip": "", "prefix": "24", "gateway": "", "dns": ""
    }
    try:
        lines = NETWORK_FILE.read_text(encoding="utf-8").splitlines()
    except OSError:
        return result
    configured_name = configured_interface()
    if configured_name != interface:
        return result
    for line in lines:
        key, separator, value = line.partition("=")
        if not separator:
            continue
        value = value.strip()
        if key.strip() == "Address" and "/" in value:
            address, prefix = value.split("/", 1)
            try:
                result["ip"] = str(ipaddress.IPv4Address(address))
                result["prefix"] = str(int(prefix))
                result["static"] = True
            except (ipaddress.AddressValueError, ValueError):
                pass
        elif key.strip() == "Gateway":
            result["gateway"] = value
        elif key.strip() == "DNS":
            result["dns"] = f"{result['dns']} {value}".strip()
    return result


def write_network(interface: str, ip: str, prefix: str, gateway: str, dns: str) -> None:
    lines = ["[Match]", f"Name={interface}", "", "[Network]"]
    if ip:
        lines.append(f"Address={ip}/{prefix}")
        if gateway:
            lines.append(f"Gateway={gateway}")
        for server in dns.split():
            lines.append(f"DNS={server}")
    else:
        lines.append("DHCP=yes")
    NETWORK_FILE.parent.mkdir(parents=True, exist_ok=True)
    NETWORK_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")
    command(["systemctl", "disable", "--now", "dhcpcd.service"])
    command(["systemctl", "enable", "--now", "systemd-networkd.service"])
    command(["systemctl", "restart", "systemd-networkd.service"])


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Set the hostname and IPv4 settings on a selected network interface."
    )
    result.add_argument("--hostname", help="Hostname to set")
    result.add_argument("--interface", help="Network interface to configure")
    result.add_argument("--ip-address", "--ip", dest="ip", help="Static IPv4 address")
    result.add_argument("--prefix-length", "--prefix", default="24", help="IPv4 prefix length")
    result.add_argument("--gateway", default="", help="Optional IPv4 gateway")
    result.add_argument("--dns", default="", help="Optional DNS servers separated by spaces")
    result.add_argument("--dhcp", action="store_true", help="Switch Ethernet back to DHCP")
    return result


def interactive() -> argparse.Namespace:
    interfaces = available_interfaces()
    default_interface = configured_interface()
    if interfaces:
        print("Available network interfaces: " + ", ".join(interfaces))
    interface = input(f"Network interface [{default_interface}]: ").strip() or default_interface
    interface = valid_interface(interface)
    network = current_network(interface)
    configured_hostname = current_hostname()
    print(f"System configuration — network interface: {interface}")
    hostname = input(f"Hostname [{configured_hostname}]: ").strip() or configured_hostname
    existing = str(network["ip"]) if network["static"] else ""
    ip = input(f"Static IPv4 address [{existing or 'DHCP'}]: ").strip()
    if not ip and existing:
        ip = existing
    prefix = input(f"Prefix length [{network['prefix']}]: ").strip() or str(network["prefix"])
    gateway = input(f"Gateway [{network['gateway']}]: ").strip() or str(network["gateway"])
    dns = input(f"DNS servers [{network['dns']}]: ").strip() or str(network["dns"])
    return argparse.Namespace(
        hostname=hostname,
        interface=interface,
        ip=ip,
        prefix_length=prefix,
        gateway=gateway,
        dns=dns,
        dhcp=False,
    )


def main() -> int:
    args = interactive() if len(sys.argv) == 1 else parser().parse_args()
    try:
        hostname = valid_hostname(args.hostname or current_hostname())
        command(["hostnamectl", "set-hostname", hostname])
        interface = valid_interface(args.interface or configured_interface())
        if args.dhcp:
            write_network(interface, "", "24", "", "")
        elif args.ip:
            ip = valid_ipv4(args.ip, "IP address", required=True)
            prefix = int(args.prefix_length)
            if not 0 <= prefix <= 32:
                raise ValueError("Prefix length must be between 0 and 32.")
            gateway = valid_ipv4(args.gateway, "Gateway")
            dns_values = [valid_ipv4(item, "DNS server", required=True) for item in args.dns.split()]
            write_network(interface, ip, str(prefix), gateway, " ".join(dns_values))
        elif args.hostname:
            print("Hostname configured. Network settings were not changed.")
        else:
            raise ValueError("Specify --ip-address or --dhcp when using command-line mode.")
    except (ValueError, RuntimeError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    print("Configuration complete.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

