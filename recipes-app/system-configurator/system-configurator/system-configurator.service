[Unit]
Description=MediaServer Textual system configurator
After=local-fs.target systemd-user-sessions.service
ConditionPathExists=/usr/bin/system-configurator

[Service]
Type=simple
ExecStart=/usr/bin/system-configurator
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target

