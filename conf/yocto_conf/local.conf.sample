# MediaServer build configuration.

# Multiconfig is supported, but the parsing is really long with it.
# I prefer to use -R conf/yocto_conf/qt5-hdmi.conf and MACHINE param
# BBMULTICONFIG = "rpi0-base rpi3-base rpi4-base rpi3-qt5 rpi4-qt5"

# Target platform
MACHINE ?= "raspberrypi4-64"
# MACHINE ?= "raspberrypi3-64"
# MACHINE ?= "raspberrypi0-2w-64"

# Build and distribution policy
DISTRO ?= "poky"
PACKAGE_CLASSES = "package_ipk"
INHERIT += "rm_work"
INIT_MANAGER = "systemd"
DISTRO_FEATURES:append = " bluez5 bluetooth wifi systemd pam pulseaudio"
DISTRO_FEATURES_OPTED_OUT += "sysvinit"
DISTRO_FEATURES:remove = "wayland"
DEFAULT_TIMEZONE = "Europe/Warsaw"
LICENSE_FLAGS_ACCEPTED = "commercial synaptics-killswitch"

# Shared image defaults
IMAGE_FSTYPES = "tar.bz2 ext3 rpi-sdimg"
BOOT_SPACE = "131072"
hostname:pn-base-files = "MediaServer"
IMAGE_INSTALL:append = " \
    linux-firmware-rpidistro-bcm43455 \
    linux-firmware-rpidistro-bcm43430 \
    bluez5 \
    i2c-tools \
    bridge-utils \
    hostapd \
    iptables \
    wpa-supplicant \
"

# FFmpeg provider configuration
PACKAGECONFIG:remove:pn-ffmpeg = "x264"
PACKAGECONFIG:remove:pn-x264 = "ffmpeg"

# Raspberry Pi boot configuration
ENABLE_UART = "1"
DISABLE_OVERSCAN = "1"
DISABLE_SPLASH = "1"
DISABLE_RPI_BOOT_LOGO = "1"
RPI_EXTRA_CONFIG = " \
dtparam=audio=on \n\
dtoverlay=pi3-miniuart-bt \n\
"
CMDLINE = "root=/dev/mmcblk0p2 rootwait console=tty1 console=ttyAMA0,115200 logo.nologo quiet loglevel=0 vt.global_cursor_default=0"

# QA and build compatibility
INSANE_SKIP:filebrowser:append = " already-stripped"
INSANE_SKIP:speedtest:append = " already-stripped"
SKIP_META_VIRT_SANITY_CHECK = "1"
PACKAGECONFIG:append:pn-qemu-system-native = " sdl"

# Build monitoring and Wrynose compatibility
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

PATCHRESOLVE = "noop"
EXTRA_IMAGE_FEATURES ?= ""
USER_CLASSES ?= "buildstats"
CONF_VERSION = "2"
BUILDHISTORY_COMMIT = "1"
