[Unit]
Description=YouTube Music cast receiver for MPD
Wants=network-online.target
After=network-online.target mpd.service bgutil-pot.service
Requires=mpd.service
Wants=bgutil-pot.service

[Service]
Type=simple
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/root/.config
Environment=DEVICE_NAME=MediaServer
Environment=MPD_HOST=127.0.0.1
Environment=MPD_PORT=6600
WorkingDirectory=/root
ExecStart=/usr/bin/ytcast-open
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
