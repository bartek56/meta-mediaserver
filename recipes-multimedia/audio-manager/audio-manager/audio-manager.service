[Unit]
Description=Media audio manager
Wants=pulseaudio.service
After=network.target sound.target bluetooth.target pulseaudio.service
Wants=bluetooth.target

[Service]
Type=simple
ExecStartPre=/usr/bin/bluetoothctl discoverable on

Environment="XDG_RUNTIME_DIR=/run/user/0"
Environment="PULSE_RUNTIME_PATH=/run/user/0/pulse"
Environment="AUDIO_MANAGER_LOG_LEVEL=DEBUG"

ExecStart=/usr/bin/audio-manager.py

StandardOutput=append:/var/log/audio-manager.log
StandardError=append:/var/log/audio-manager.log

KillMode=control-group
TimeoutStopSec=3

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

